// Prisma schema for SIREDOM (Sistem Rekapitulasi Domino)
// Managed PostgreSQL Database setup (Supabase Cloud DB)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  WASIT
}

enum MatchMode {
  ROUNDS
  POINTS
}

enum MatchStatus {
  SETUP
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionType {
  MENANG_BIASA
  KANDANG
  CEKI
  PALANG
  TANGKAP
}

// 1. Tabel Master Tenant (SaaS Warkop / Cafe Mitra)
model Tenant {
  id                String         @id @default(uuid())
  name              String
  slug              String         @unique
  code              String         @unique
  adminEmail        String         @default("admin@tabslowbar.com")
  adminPasswordHash String         @default("$2b$10$/nCfsjyVRAZ.n8m3YEMlZO9tKFMMg93dufln4JBs45CDlBB/Xvur2")
  subscriptionPlan  String         @default("pro") // basic, pro, enterprise
  status            String         @default("active") // active, suspended, expired
  maxTables         Int            @default(10)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  users             User[]
  tableMasters      TableMaster[]
  matchSessions     MatchSession[]
}

// 2. Tabel Pengguna (Superadmin, Cafe Admin, & Wasit Login)
model User {
  id           String   @id @default(uuid())
  tenantId     String?
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// 3. Tabel Master Meja Wasit Per Tenant
model TableMaster {
  id            String         @id @default(uuid())
  tenantId      String
  tableNumber   Int
  tableName     String
  pinCode       String         // 4-digit PIN Wasit Login
  status        String         @default("active") // active, idle, maintenance
  isLocked      Boolean        @default(false)
  activeDeviceId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matchSessions MatchSession[]

  @@unique([tenantId, tableNumber])
}

// 4. Tabel Sesi Pertandingan Live Per Meja
model MatchSession {
  id          String       @id @default(uuid())
  tenantId    String
  tableId     String
  tableNumber Int          @default(1)
  matchMode   MatchMode    @default(ROUNDS)
  targetValue Int          @default(10)
  pointsConfig Json?       // Konfigurasi Poin (+1, +2, +3, +4, -3)
  status      MatchStatus  @default(IN_PROGRESS)
  winnerId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table       TableMaster  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  players     Player[]
  rounds      Round[]
}

// 5. Tabel Pemain Pertandingan (4 Kursi Per Meja)
model Player {
  id           String       @id @default(uuid())
  matchId      String
  seatNumber   Int          // 1: Merah, 2: Biru, 3: Hijau, 4: Kuning
  name         String
  currentScore Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  match        MatchSession @relation(fields: [matchId], references: [id], onDelete: Cascade)
  roundScores  RoundScore[]

  @@unique([matchId, seatNumber])
}

// 6. Tabel History Ronde Pertandingan
model Round {
  id             String       @id @default(uuid())
  matchId        String
  roundNumber    Int
  actionType     ActionType
  winnerPlayerId String
  victimPlayerId String?      // Khusus aksi 'tangkap'
  timestamp      DateTime     @default(now())

  match          MatchSession @relation(fields: [matchId], references: [id], onDelete: Cascade)
  scores         RoundScore[]

  @@unique([matchId, roundNumber])
}

// 7. Tabel Rincian Skor & Status Player Per Ronde
model RoundScore {
  id            String   @id @default(uuid())
  roundId       String
  playerId      String
  statusTag     String   // 'menang', 'ditangkap', 'berdiri', 'duduk'
  pointsAwarded Int
  scoreAfter    Int

  round         Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
}
