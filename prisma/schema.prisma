// Prisma schema for SIREDOM (Sistem Rekapitulasi Domino)
// Managed PostgreSQL Database setup (Supabase Cloud DB)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  WASIT
}

enum MatchMode {
  ROUNDS
  POINTS
}

enum RulesetMode {
  CASUAL
  PB_PORDI
  PB_ORADO
}

enum MatchCategory {
  SINGLE_1V1V1V1
  TEAM_2V2
}

enum TeamIdentifier {
  NONE
  TEAM_A
  TEAM_B
}

enum MatchStatus {
  SETUP
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionType {
  MENANG_BIASA
  KANDANG
  CEKI
  PALANG
  TANGKAP
  ORADO_COUNT
  DENDA_POIN
}

enum RoundStatusTag {
  MENANG
  DITANGKAP
  BERDIRI
  DUDUK
  DENDA
}

// 1. Tabel Master Tenant (SaaS Warkop / Cafe Mitra)
model Tenant {
  id                String         @id @default(uuid())
  name              String
  slug              String         @unique
  code              String         @unique
  adminEmail        String         @default("admin@tabslowbar.com")
  adminPasswordHash String         @default("$2b$10$/nCfsjyVRAZ.n8m3YEMlZO9tKFMMg93dufln4JBs45CDlBB/Xvur2")
  subscriptionPlan  String         @default("pro") // basic, pro, enterprise
  status            String         @default("active") // active, suspended, expired
  maxTables         Int            @default(10)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  users             User[]
  tableMasters      TableMaster[]
  matchSessions     MatchSession[]
}

// 2. Tabel Pengguna (Superadmin, Cafe Admin, & Wasit Login)
model User {
  id           String   @id @default(uuid())
  tenantId     String?
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// 3. Tabel Master Meja Wasit Per Tenant
model TableMaster {
  id            String         @id @default(uuid())
  tenantId      String
  tableNumber   Int
  tableName     String
  pinCode       String         // 4-digit PIN Wasit Login
  status        String         @default("active") // active, idle, maintenance
  isLocked      Boolean        @default(false)
  activeDeviceId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matchSessions MatchSession[]

  @@unique([tenantId, tableNumber])
}

// 4. Tabel Sesi Pertandingan Live Per Meja (JSON Document-Relational Model)
model MatchSession {
  id            String         @id @default(uuid())
  tenantId      String
  tableId       String
  tableNumber   Int            @default(1)
  rulesetMode   RulesetMode    @default(CASUAL)
  matchCategory MatchCategory  @default(SINGLE_1V1V1V1)
  matchMode     MatchMode      @default(ROUNDS)
  targetType    String         @default("FIXED_ROUNDS") // "FIXED_ROUNDS" | "RACE_TO_POINTS" | "SET_101"
  targetValue   Int            @default(10)
  currentSet    Int            @default(1)
  teamASetWins  Int            @default(0)
  teamBSetWins  Int            @default(0)
  pointsConfig  Json?          // Konfigurasi Poin (+1, +2, +3, +4, -3)
  rulesConfig   Json?          // Menyimpan bobot poin / ORADO configs
  playersData   Json?          // Array of player objects [{ id, seatNumber, name, teamIdentifier, currentScore, totalScore }]
  roundsHistory Json?          // Array of round objects [{ id, setNumber, roundNumber, actionType, winnerPlayerId, winnerTeam, victimPlayerId, winType, rawPointsInput, isPenalty, timestamp, scores }]
  status        MatchStatus    @default(IN_PROGRESS)
  winnerId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table         TableMaster    @relation(fields: [tableId], references: [id], onDelete: Cascade)
}
