# ===================================================
# SIREDOM SaaS Domino Scorer - Environment Variables Template
# ===================================================

# 1. Supabase Connection Pooling (for Serverless Next.js App & Vercel Functions - Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-SUPABASE-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Supabase Client SDK Credentials
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-SUPABASE-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# 3. App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
